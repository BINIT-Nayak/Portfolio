{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs",
    "lint:style": "stylelint \"**/*.{css,scss}\" --cache",
    "lint:style:fix": "stylelint \"**/*.{css,scss}\" --fix --cache",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint:eslint && npm run lint:style && npm run format:check",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.17.0",
    "clsx": "^2.1.0",
    "mini-svg-data-uri": "^1.4.4",
    "next": "15.5.29",
    "next-themes": "^0.3.0",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.0.1",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <23 || >=24.0.0 <25"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    },
    "minimatch@3": {
      "brace-expansion": "^1.1.22"
    }
  }
}
